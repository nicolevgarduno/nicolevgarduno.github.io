---
layout: default
---
{% comment %}
  Detail page for a _news item. Set as the collection default in _config.yml.

  News entries are short, so this is deliberately simpler than the gem's post
  layout: back link, headline, date, optional image, body, and an outbound link
  when the item points at coverage published elsewhere.
{% endcomment %}

<div class="post">
  <p class="nvg-back">
    <a href="{{ '/news/' | relative_url }}"><i class="fa-solid fa-arrow-left"></i>All news</a>
  </p>

  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-meta nvg-news-date">{{ page.date | date: '%b %d, %Y' }}</p>
  </header>

  <article>
    {% if page.thumbnail %}
      {% comment %}
        Strip double quotes: figure.liquid interpolates alt into an attribute
        unescaped, so a title containing " breaks the <img> tag.
      {% endcomment %}
      {% assign hero_alt = page.title | replace: '"', '' %}
      <div class="nvg-news-hero">
        {% include figure.liquid loading="eager" path=page.thumbnail alt=hero_alt class="img-fluid" %}
      </div>
    {% endif %}

    {{ content }}

    {% if page.external_url %}
      <p class="nvg-news-external">
        <a href="{{ page.external_url }}">
          {{ page.external_label | default: 'Read the full story' }}
          <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i>
        </a>
      </p>
    {% endif %}
  </article>
</div>
