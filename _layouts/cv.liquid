---
layout: default
---
{% comment %}
  Local override of al_folio_core's _layouts/cv.liquid.

  The gem layout calls {% al_folio_cv_render %}, whose template hardcodes the
  section order (Contact Info, Summary, Experience, then everything else) and
  routes any section it doesn't recognise to a plain label/details renderer.

  This site needs a specific order — Professional Summary, Experience, Projects,
  Education, Leadership, Awards — and needs Leadership to get the same date/location
  badges as Experience. So the sections are rendered directly here instead.

  The gem's per-section partials are still used: al_folio_cv registers its
  templates/ directory on Jekyll's includes_load_paths, so `cv/experience.liquid`
  and friends resolve to the gem's copies. Only the ordering lives locally.

  Content is in _data/cv.yml.
{% endcomment %}

{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled and site.data.cv and site.data.cv.cv %}
  {% assign cv = site.data.cv.cv %}

  <div class="post">
    <header class="post-header">
      <h1 class="post-title">
        {{ page.title }}
        {% if page.cv_pdf %}
          <a
            {% if page.cv_pdf contains '://' %}
              href="{{ page.cv_pdf }}"
            {% else %}
              href="{{ page.cv_pdf | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            class="float-right"
            title="Download as PDF"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </h1>
      {% if page.description %}
        <p class="post-description">{{ page.description }}</p>
      {% endif %}
    </header>

    <article>
      <div class="cv">
        {% if cv.summary %}
          <a class="anchor" id="professional-summary"></a>
          <div class="card mt-3 p-3">
            <h3 class="card-title font-weight-medium">Professional Summary</h3>
            <p>{{ cv.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
          </div>
        {% endif %}

        {% comment %}
          Order is explicit rather than a loop over cv.sections, so reordering the
          page means editing this list — not reshuffling the data file.

          `renderer` picks which gem partial formats the entries. Leadership uses
          the experience renderer so it gets date and location badges.
        {% endcomment %}
        {% assign section_names = 'Experience,Projects,Education,Leadership,Awards' | split: ',' %}

        {% for section_name in section_names %}
          {% assign entries = cv.sections[section_name] %}
          {% if entries and entries.size > 0 %}
            {% if section_name == 'Education' %}
              {% assign entries = entries | al_cv_sort_by_date %}
            {% endif %}

            <a class="anchor" id="{{ section_name | slugify }}"></a>
            <div class="card mt-3 p-3">
              <h3 class="card-title font-weight-medium">{{ section_name }}</h3>
              <div>
                {% case section_name %}
                  {% when 'Education' %}
                    {% include cv/education.liquid %}
                  {% when 'Awards' %}
                    {% include cv/awards.liquid %}
                  {% when 'Projects' %}
                    {% include cv/projects.liquid %}
                  {% else %}
                    {% comment %} Experience and Leadership both use the experience renderer. {% endcomment %}
                    {% include cv/experience.liquid %}
                {% endcase %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin, set <code>al_folio.features.cv.enabled: true</code>, and provide <code>_data/cv.yml</code>.</p>
    </article>
  </div>
{% endif %}
